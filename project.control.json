{
  "schema": "forge.project.v1",
  "project": {
    "id": "forgepy",
    "name": "ForgePY",
    "kind": "python-application",
    "version": "0.4.415-F60R415",
    "build": "FORGEPY-F60R415"
  },
  "root_control_center": {
    "launcher": "ForgePY.cmd"
  },
  "quality_gates": [
    {
      "key": "gate.full",
      "label": "Full Quality Gate / Certify GREEN"
    },
    {
      "key": "gate.fast",
      "label": "Quick ForgePY Gate"
    }
  ],
  "commands": [
    {
      "key": "gate.full",
      "label": "FULL QUALITY GATE / CERTIFY GREEN",
      "category": "gate",
      "risk": "write",
      "program": "python",
      "args": [
        "tools/ForgePYGate.py",
        "full"
      ],
      "mutates": true
    },
    {
      "key": "gate.fast",
      "label": "Quick ForgePY Gate",
      "category": "gate",
      "risk": "read",
      "program": "python",
      "args": [
        "tools/ForgePYGate.py",
        "quick"
      ]
    },
    {
      "key": "build.native",
      "label": "Build / Syntax Verify",
      "category": "build",
      "risk": "write",
      "program": "python",
      "args": [
        "tools/ForgePYGate.py",
        "build"
      ],
      "mutates": true
    },
    {
      "key": "run.gui",
      "label": "Run ForgePY GUI",
      "category": "run",
      "risk": "read",
      "program": "python",
      "args": [
        "app/ForgePYStandalone.py",
        "--root",
        "{root}"
      ]
    },
    {
      "key": "project.self-test",
      "label": "ForgePY Self Test",
      "category": "diagnostics",
      "risk": "read",
      "program": "python",
      "args": [
        "app/ForgePYStandalone.py",
        "--self-test"
      ]
    }
  ],
  "stateDirectory": ".forge",
  "sourceControl": {
    "github": {
      "remote": "origin",
      "cloneUrl": "https://github.com/shifty81/Forge.git",
      "webUrl": "https://github.com/shifty81/Forge"
    },
    "defaultGitHubRemote": "origin",
    "defaultForgejoRemote": "forgejo",
    "forgejo": {
      "role": "optional-compatibility"
    },
    "forgeGit": {
      "enabled": true,
      "remote": "forgegit",
      "role": "primary-local-authority"
    }
  },
  "updates": {
    "incoming": "incoming.patch",
    "patchSchema": "forge.patch.v1",
    "downloadsAutoQueue": false,
    "approvalRequiredForDownloads": true,
    "artifactAuthority": "forgepy",
    "lineageAuthority": "artifact-central"
  }
}
